# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN commit file .env ke repository!

# URL backend API
VITE_API_BASE_URL=http://localhost:8000/api

# Midtrans Payment Gateway
# Dapatkan dari: https://dashboard.midtrans.com/settings/config_info
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
VITE_MIDTRANS_ENVIRONMENT=sandbox

# Google OAuth Client ID
# Dapatkan dari: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
